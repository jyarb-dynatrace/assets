{
  "name": "@dynatrace/js-runtime",
  "version": "1.145.0",
  "keywords": [
    "Dynatrace-AppEngine",
    "runtime",
    "js-runtime"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "license": "See license in LICENSE.txt",
  "devDependencies": {
    "@jest/environment": "^31.145.0",
    "@jest/fake-timers": "^31.145.0",
    "@jest/types": "^31.145.0",
    "chalk": "^4.1.2",
    "esbuild": "^0.28.0",
    "jest": "~30.3.0",
    "jsonwebtoken": "^9.0.2",
    "ts-jest": "^29.0.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "undici": "^6.22.0",
    "urlpattern-polyfill": "^11.145.0"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "build": "tsc && npm run build:test-environment",
    "build:test-environment": "esbuild test-environment/index.ts --bundle --platform=node --minify --outfile=lib/test-environment/index.js",
