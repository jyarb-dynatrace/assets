    "test:environment": "jest --config=jest.config.js"
  },
  "optionalDependencies": {
    "@dynatrace/js-runtime-darwin-arm64": "1.145.0",
    "@dynatrace/js-runtime-darwin-x64": "1.145.0",
    "@dynatrace/js-runtime-linux-x64-gnu": "1.145.0",
    "@dynatrace/js-runtime-win32-x64-msvc": "1.145.0"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "types",
    "dynatrace-metadata.json",
    "lib",
    "capabilities"
